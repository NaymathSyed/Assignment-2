<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title><%= title %> | Naymath Syed</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" rel="stylesheet">

    <!-- Custom website styles -->
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body>
    <!-- Navigation bar shared by all pages -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">
                Naymath Syed
            </a>

            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainMenu"
                    aria-controls="mainMenu"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainMenu">
                <div class="navbar-nav ms-auto">
                    <a class="nav-link<%= title === 'Home' ? ' active' : '' %>" href="/" <% if (title === 'Home') { %>aria-current="page"<% } %>>Home</a>
                    <a class="nav-link<%= title === 'About Me' ? ' active' : '' %>" href="/about" <% if (title === 'About Me') { %>aria-current="page"<% } %>>About</a>
                    <a class="nav-link<%= title === 'Projects' ? ' active' : '' %>" href="/projects" <% if (title === 'Projects') { %>aria-current="page"<% } %>>Projects</a>
                    <a class="nav-link<%= title === 'Contact Me' ? ' active' : '' %>" href="/contact" <% if (title === 'Contact Me') { %>aria-current="page"<% } %>>Contact</a>
                </div>
            </div>
        </div>
    </nav>

    <main class="container">
