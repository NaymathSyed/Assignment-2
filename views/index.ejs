<%- include('partials/header') %>


<!-- Home page introduction -->
<section class="hero">
    <div class="row align-items-center">

        <!-- Introduction on the left -->
        <div class="col-md-7">
            <div class="hero-content">

                <p class="intro-badge">
                    Welcome to my portfolio
                </p>

                <h1>
                    Hello, I'm an
                    <span>IT Student & Developer.</span>
                </h1>

                <p class="hero-description">
                    I enjoy programming, exploring technology,
                    and building creative projects.
                    Welcome to my personal portfolio!
                </p>

                <div class="hero-buttons">
                    <a href="/projects" class="btn btn-purple">
                        View My Projects
                    </a>

                    <a href="/contact" class="btn btn-contact">
                        <i class="fa-solid fa-envelope"></i>
                        Contact Me
                    </a>
                </div>

            </div>
        </div>

        <!-- Your picture on the right -->
        <div class="col-md-5 text-center mt-4 mt-md-0">
            <img src="/images/profile.jpg"
                 alt="My profile picture"
                 class="profile-picture img-fluid">
        </div>

    </div>
</section>

<!-- Language section -->
<section class="skills-preview text-center">
    <h2>Different Languages I Work With</h2>

    <div class="row mt-4">

        <div class="col-md-3 col-6 mb-3">
            <div class="skill-box">
                <i class="fa-brands fa-html5"></i>
                <p>HTML</p>
            </div>
        </div>

        <div class="col-md-3 col-6 mb-3">
            <div class="skill-box">
                <i class="fa-brands fa-css3-alt"></i>
                <p>CSS</p>
            </div>
        </div>

        <div class="col-md-3 col-6 mb-3">
            <div class="skill-box">
                <i class="fa-brands fa-js"></i>
                <p>JavaScript</p>
            </div>
        </div>

        <div class="col-md-3 col-6 mb-3">
            <div class="skill-box">
                <i class="fa-brands fa-python"></i>
                <p>Python</p>
            </div>
        </div>

        <div class="col-md-3 col-6 mb-3">
            <div class="skill-box">
                <i class="cpp-icon">C++</i>
                <p>C++</p>
            </div>
        </div>

    </div>
</section>

<%- include('partials/footer') %>